# devtrack_client .env_sample — Go client vars only
# Copy to .env and fill in your values.
# Server-only vars (Python, admin, MongoDB, etc.) are not listed here.
# See monorepo .env_sample for the full list.

## PATHS

PROJECT_ROOT=/path/to/devtrack_client
DEVTRACK_HOME=${PROJECT_ROOT}

# Single-repo mode: path to the git repo to monitor
DEVTRACK_WORKSPACE=${PROJECT_ROOT}

# Optional: path to workspaces.yaml for multi-repo mode
# WORKSPACES_FILE=/custom/path/to/workspaces.yaml

DATA_DIR=${PROJECT_ROOT}/Data
DATABASE_DIR=${DATA_DIR}/db
LOG_DIR=${DATA_DIR}/logs
PID_DIR=${DATA_DIR}/pids
CONFIG_DIR_PATH=${DATA_DIR}/configs
LEARNING_DIR_PATH=${DATA_DIR}/learning

## DAEMON / CLI INTERNALS

# Server connection mode: managed | external
DEVTRACK_SERVER_MODE=managed

# URL of the Python backend server (auto-defaulted in managed mode)
DEVTRACK_SERVER_URL=

# TLS for Go<->Python channel (default: true)
DEVTRACK_TLS=true
DEVTRACK_TLS_CERT=Data/tls/server.crt
DEVTRACK_TLS_KEY=Data/tls/server.key

# API key for /trigger/* requests (X-DevTrack-API-Key header)
DEVTRACK_API_KEY=

## IPC AND DAEMON CONFIGURATION

IPC_HOST=127.0.0.1
IPC_PORT=35893
IPC_CONNECT_TIMEOUT_SECS=5
IPC_RETRY_DELAY_MS=500
CLI_BINARY_NAME=devtrack
CONFIG_FILE_NAME=config.yaml
DATABASE_FILE_NAME=devtrack.db
PID_FILE_NAME=daemon.pid
LOG_FILE_NAME=daemon.log
LEARNING_DIR_NAME=learning
CONFIG_DIR_NAME=.devtrack
CLI_APP_NAME=DevTrack
CLI_DAEMON_NAME=devtrack

## LLM PROVIDERS (client-side: git-sage only)

# Provider for git-sage. Values: ollama | openai | groq
GIT_SAGE_PROVIDER=ollama
GIT_SAGE_DEFAULT_MODEL=llama3.2

## OLLAMA (used by git-sage in local mode)

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

## LMSTUDIO

LMSTUDIO_HOST=http://localhost:1234

## TIMEOUTS AND INTERNALS

HTTP_TIMEOUT_SHORT_SECS=5
HTTP_TIMEOUT=60
HTTP_TIMEOUT_LONG=120

# Go daemon's internal HTTP server (stats, sessions, force-trigger).
# Python server calls IPC_HOST:DEVTRACK_SERVER_HTTP_PORT to read live stats.
# Keep in sync with DEVTRACK_SERVER_HTTP_PORT in devtrack_server/.env.
DEVTRACK_SERVER_HTTP_PORT=35894

## APPLICATION SETTINGS

PROMPT_INTERVAL=30
WORK_HOURS_ONLY=true
WORK_START_HOUR=9
WORK_END_HOUR=18
TIMEZONE=UTC
# Force UTF-8 for stdout/stderr (required on Windows — prevents cp1252 encoding crashes)
PYTHONIOENCODING=utf-8
LOG_LEVEL=info
AUTO_SYNC=true
OUTPUT_TYPE=both
DAILY_REPORT_TIME=18:00
WEEKLY_REPORT_DAY=Friday
SEND_ON_TRIGGER=false
SEND_DAILY_SUMMARY=true

## GITHUB
# Secret + alert user only — owner/repo/api_url go in workspaces.yaml.

GITHUB_TOKEN=
GITHUB_USER=                    # Go alert poller user ID (falls back to EMAIL)

## AZURE DEVOPS
# Go reads PAT (connector + health check), ORGANIZATION + PROJECT (health check + devtrack settings), EMAIL (alert poller).
# All other config (api_url, sync flags) goes in workspaces.yaml or the server .env.

AZURE_DEVOPS_PAT=
AZURE_API_KEY=                  # alias for AZURE_DEVOPS_PAT
AZURE_ORGANIZATION=
AZURE_PROJECT=
AZURE_EMAIL=

## GITLAB
# Go reads GITLAB_PAT for the connector. All other config goes in workspaces.yaml.

GITLAB_PAT=

## WEBHOOK SERVER (Go client connects to this)

WEBHOOK_ENABLED=false
WEBHOOK_PORT=8089

## TICKET SYNC
# Go syncs tickets from PM APIs → local SQLite, then pushes a slim payload to the
# Python server (POST /trigger/ticket_sync) for fuzzy/semantic matching.
# Push failures are non-fatal: local cache is always written first.

TICKET_SYNC_ON_START=true           # push cached tickets to server 5s after daemon starts
TICKET_SYNC_INTERVAL_HOURS=4        # background full-sync interval (scrums happen ~12h apart)
                                    # Run 'devtrack ticket-sync --force' to force drop+reload

## SERVER EVENT SYNC (opt-in: sends local activity rows to the configured Python server)
SERVER_EVENT_SYNC_ENABLED=false
SERVER_EVENT_SYNC_BATCH_SIZE=100

## HEALTH CHECKS AND QUEUE MANAGEMENT

HEALTH_CHECK_INTERVAL_SECS=30
HEALTH_AUTO_RESTART_PYTHON=true
HEALTH_AUTO_RESTART_WEBHOOK=true
HEALTH_MAX_RESTARTS_PER_HOUR=3
QUEUE_DRAIN_INTERVAL_SECS=10
QUEUE_MAX_RETRIES=10
QUEUE_RETENTION_DAYS=7
DEFERRED_COMMIT_EXPIRY_HOURS=72

## PENDING ACTIONS QUEUE (Phase 1)

# How often (in seconds) the queue executor polls /queue/pending for expired
# actions to auto-approve. Shorter values mean faster auto-approval but more
# HTTP traffic to the Python server.
QUEUE_POLL_INTERVAL_SECS=15

## EOD REPORT (Phase 4)

# Hour (0-23) at which the daily EOD report cron fires. 0 = disabled.
# Combine with EOD_REPORT_MINUTE to fire at any HH:MM, e.g. 18:30.
EOD_REPORT_HOUR=18
# Minute (0-59) within the hour. Default 0 (fires on the hour).
EOD_REPORT_MINUTE=0
# Email recipient for the EOD report. Empty string = no email delivery.
EOD_REPORT_EMAIL=
# Set true to receive EOD reports in Telegram (requires TELEGRAM_ENABLED=true).
EOD_TELEGRAM_ENABLED=false
# Auto-stop idle work sessions after this many minutes. 0 = disabled.
WORK_SESSION_AUTO_STOP_MINUTES=0

## VOICE TRAINING (Phase 5)
# How many months of git commit history to embed into ChromaDB for voice seeding.
# Run `devtrack voice seed` to trigger seeding manually at any time.
VOICE_SEED_MONTHS=6
# How often (in hours) the background voice sync polls PM platforms for PR descriptions
# and issue comments. Run `devtrack voice sync` to trigger manually at any time.
VOICE_SYNC_INTERVAL_HOURS=24

## PR PUPPET MASTER / REVIEW AGENT (Phase 7)
# Which coding agent CLI to invoke when applying auto-fixes for PR review comments.
# Valid values: claude-code | copilot-cli
# Defaults to claude-code when unset.
REVIEW_AGENT=claude-code
# Maximum seconds to wait for the coding agent subprocess to complete.
# Required — no default. Increase for large repos or complex fixes.
REVIEW_AGENT_TIMEOUT_SECS=120
# How often (in seconds) the fix loop polls for PR approval state after a fix is applied.
# Required — no default.
REVIEW_POLL_INTERVAL_SECS=30

## NOTIFICATIONS (teams + email — Go client sends these)

EMAIL_TO_ADDRESSES=dev@example.com
EMAIL_CC_ADDRESSES=
EMAIL_MANAGER=
EMAIL_SUBJECT="DevTrack Daily Report"
TEAMS_CHANNEL_ID=
TEAMS_CHANNEL_NAME=
TEAMS_CHAT_ID=
TEAMS_CHAT_TYPE=channel
TEAMS_WEBHOOK_URL=
TEAMS_MENTION_USER=false

## TELEGRAM

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

## SLACK

SLACK_WEBHOOK_URL=

## LEARNING AND PERSONALIZATION

LEARNING_DEFAULT_DAYS=30

## WORKSPACES (multi-repo mode)

# WORKSPACES_FILE is already declared above under PATHS

## GIT COMMIT AUTO-ENHANCEMENT

# When true, the daemon watches for commits made via plain `git commit` and
# uses Ollama (or the configured LLM) to generate a better commit message,
# then amends the commit in-place. The amended commit is never pushed — it is
# only safe to amend unpushed commits, and DevTrack checks before amending.
# Requires OLLAMA_HOST to be reachable (or the SAGE_PROVIDER LLM).
# Default: false (opt-in)
DEVTRACK_AUTO_ENHANCE=false

## OFFLINE RESILIENCE

GIT_NO_DEVTRACK=0

## TELEMETRY (anonymous ping — set to empty to disable)

# DEVTRACK_PING_URL=https://ping.devtrack.dev

## DEVTRACK CLOUD / API

DEVTRACK_API_URL=
DEVTRACK_AUTO_ACCEPT_TERMS=false

## BUILD METADATA

DEVTRACK_VERSION=v3.0.0
DEVTRACK_BUILD_DATE=2026-04-23

## MCP SERVER (Phase 8)

# MCP server port. 0 = stdio-only (Claude Code integration). Set a port for HTTP/SSE mode (future).
MCP_PORT=0
