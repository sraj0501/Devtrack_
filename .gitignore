# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
*.idea
*.env


# Golang Files
*.exe
go-cli
devtrack-bin/devtrack
devtrack_client/devtrack
devtrack_client/devtrack.exe
devtrack
*.log


# Runtime data (db, logs, pids, reports, learning data)
# Use Data/* (not Data/) so negation exceptions below work
Data/*
!Data/agent_logs/
!Data/agent_logs/**

# Local workspace config (contains machine-specific paths/tokens)
workspaces.yaml

# Test temp dirs
.test_commit_enhancer_tmp

# Claude Code — exclude machine-specific settings, keep shared agents
.claude/settings.local.json
.claude/worktrees/

# Local clones of GitLab split repos (separate git repos, not submodules)
# NOTE: devtrack_client/ and devtrack_server/ are tracked as part of the EPIC-SPLIT
# restructure (TASK-042/TASK-043). They are source directories, not git repo clones.
devtrack_wiki/
