# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
*.idea
*.env


# Golang Files
*.exe
go-cli
devtrack-bin/devtrack
devtrack_client/devtrack
devtrack_client/devtrack.exe
devtrack
*.log


# Runtime data (db, logs, pids, reports, learning data)
# Use Data/* (not Data/) so negation exceptions below work
Data/*
!Data/agent_logs/
!Data/agent_logs/**

# devtrack_server runtime data (mirrors root Data/* pattern)
devtrack_server/Data/*
!devtrack_server/Data/agent_logs/
!devtrack_server/Data/agent_logs/**

# Local workspace config (contains machine-specific paths/tokens)
workspaces.yaml

# Test temp dirs
.test_commit_enhancer_tmp
devtrack_client/devtrack_test_bin
devtrack_client/*.zip

# Claude Code — exclude machine-specific settings, keep shared agents
.claude/settings.local.json
.claude/worktrees/

# Log Files
*.log